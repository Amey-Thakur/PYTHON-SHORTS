# Python Shorts - Academic Repository
# Specialized .gitignore for Python development and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
# .DS_Store is explicitly kept in root for archival purposes
# .DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Temporary and State Files
*.tmp
*.bak
*.sav
*.old
~*

# Archives
*.zip
*.tar.gz
*.rar
*.7z
